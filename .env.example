# ============================================================
# Локальная разработка (Vite)
# ============================================================

# Базовый URL API. По умолчанию относительный /api/v1 (прокси Vite).
# VITE_API_URL=http://localhost:8080/api/v1

# Моки API для разработки без бэкенда. В Docker-образ не попадают.
VITE_USE_MOCKS=false

# ============================================================
# Docker (docker compose)
# ============================================================

# Адрес API Gateway, доступный из контейнера. Без завершающего слэша.
# Docker Desktop: http://host.docker.internal:8080
# Бэкенд в той же compose-сети: http://backend:8080
BACKEND_URL=http://host.docker.internal:8080

# Порт, на котором фронтенд доступен на хосте
FRONTEND_PORT=8082
